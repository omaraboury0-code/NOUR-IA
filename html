              <p class="text-[11px] text-gray-500">Kelaat M'gouna</p>
            </div>
            <div class="bg-white p-3 rounded-2xl border border-sandSoft">
              <p class="text-xs font-bold text-oliveBio">💵 Cash Livraison</p>
              <p class="text-[11px] text-gray-500">Zéro risque</p>
            </div>
            <div class="bg-white p-3 rounded-2xl border border-sandSoft">
              <p class="text-xs font-bold text-oliveBio">🚚 24h – 48h</p>
