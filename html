      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between text-xs">
        <div class="flex items-center gap-2 text-gray-600">
          <button onclick="showHomeView()" class="hover:text-kasbahTerra font-semibold">Accueil</button>
          <span>/</span>
          <span id="pd-breadcrumb-cat" class="text-gray-500">Catalogue</span>
          <span>/</span>
          <span id="pd-breadcrumb-name" class="text-oliveBio font-bold truncate max-w-[180px] sm:max-w-xs"></span>
        </div>
        <button onclick="showHomeView()" class="text-kasbahTerra font-bold hover:underline">← Retour à la boutique</button>
      </div>
    </div>

