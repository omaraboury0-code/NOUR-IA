  <script>
    const PACKS = [
      { id: 'PACK-01', name: 'Coffret Éclat Rose de Damas', price: 249, oldPrice: 310, discount: '-20%', img: 'ref-01.jpg', desc: 'Eau de rose pure + Huile de rose + Savon naturel de Kelaat M\'gouna.' },
      { id: 'PACK-02', name: 'Rituel Beauté Royale', price: 289, oldPrice: 360, discount: '-20%', img: 'hero-produits.jpg', desc: 'Tabrima Rose + Parfum Mille Roses + Savon Lait d\'Ânesse.' },
      { id: 'PACK-03', name: 'Coffret Soin Cheveux & Corps', price: 269, oldPrice: 330, discount: '-18%', img: 'ref-23.jpg', desc: 'Shampoing naturel + Huile végétale + Ghassoul Aker Fassi.' }
    ];

    const CATEGORY_NAMES = {
      huiles: 'Huiles & Eaux Florales',
      cremes: 'Crèmes & Beurres',
      cheveux: 'Soins Capillaires',
      hammam: 'Hammam & Corps',
      parfums: 'Parfums & Makhmariya'
    };

    const BASE_ITEMS = {
      huiles: [
        'Eau de Rose 1ère Distillation', 'Huile de Rose de Damas Pure', 'Huile d\'Argan Bio Cosmétique', 'Huile de Figue de Barbarie',
        'Huile de Nigelle Pure', 'Huile d\'Amande Douce', 'Huile de Ricin Bio', 'Huile d\'Avocat Naturelle',
        'Hydrolat de Fleur d\'Oranger', 'Sérum Éclat Rose & Argan'
      ],
      cremes: [
        'Crème Visage à la Rose Bio', 'Crème Hydratante Argan & Rose', 'Beurre de Karité Naturel', 'Crème Contour des Yeux Rose',
        'Crème Nuit Régénérante', 'Crème Mains Nourrissante', 'Baume Lèvres Aker Fassi', 'Crème Éclaircissante Douce',
        'Gel Aloe Vera & Rose', 'Crème Apaisante Peaux Sensibles', 'Lait Corps Rose de Damas', 'Crème Anti-Âge Botanique'
      ],
      cheveux: [
        'Shampoing Fortifiant à la Rose', 'Masque Capillaire Argan & Kératine', 'Huile Cheveux 10 Plantes', 'Bain d\'Huile Ricin & Romarin',
        'Sérum Pointes Seches', 'Après-Shampoing Démêlant Doux', 'Poudre Sidr & Henné Bio', 'Huile Pousse Cheveux',
        'Brume Capillaire Parfumée Rose', 'Soin Réparateur Cheveux Abîmés'
      ],
      hammam: [
        'Tabrima Traditionnelle à la Rose', 'Savon Noir Beldi à l\'Huile d\'Olive', 'Ghassoul à l\'Aker Fassi', 'Savon Artisanal Rose de Damas',
        'Savon au Lait d\'Ânesse', 'Savon à l\'Indigo Naturel', 'Gommage Corps Sucre & Rose', 'Savon Miel & Propolis',
        'Savon Argile Verte & Menthe', 'Savon Curcuma & Argan', 'Savon Charbon Actif & Rose', 'Gommage Visage Doux à la Rose',
        'Savon Lavande & Rose', 'Sel de Bain à la Rose', 'Savon Fleur de Coton & Rose', 'Kit Hammam Complet Coopérative'
      ],
      parfums: [
        'Parfum Mille Roses Kelaat M\'gouna', 'Makhmariya Corps & Cheveux Rose', 'Musc Blanc & Rose de Damas', 'Extrait de Parfum Vallée des Roses',
        'Brume Parfumée Fraîcheur Rose'
      ]
    };

    const PRODUCTS = [];
    let idxCounter = 1;
    Object.entries(BASE_ITEMS).forEach(([cat, names]) => {
      names.forEach((name) => {
        const code = `REF-${String(idxCounter).padStart(2, '0')}`;
        const price = 65 + ((idxCounter * 7) % 85);
        const oldPrice = price + 25;
        const discount = idxCounter % 2 === 0 ? `-${Math.round(((oldPrice - price) / oldPrice) * 100)}%` : '';
        PRODUCTS.push({
          id: code,
          cat,
          name,
          price,
          oldPrice,
          discount,
          img: `${code.toLowerCase()}.jpg`,
          desc: `Produit naturel de la coopérative de Kelaat M'gouna (${CATEGORY_NAMES[cat]}).`
        });
        idxCounter++;
      });
    });

    let activeCat = 'all';
    let searchQuery = '';
    let cart = [];

    function productCardHTML(item) {
      return `
        <div class="product-card bg-white rounded-2xl border border-sandSoft overflow-hidden flex flex-col justify-between">
          <div>
            <div class="relative aspect-square bg-creamBg overflow-hidden">
              <img src="${item.img}" onerror="this.src='bg-site.jpg';" alt="${item.name}" class="w-full h-full object-cover" />
              ${item.discount ? `<span class="absolute top-2.5 left-2.5 bg-kasbahTerra text-white text-[10px] font-extrabold px-2 py-0.5 rounded-full">${item.discount}</span>` : ''}
              <button onclick="openQuickView('${item.id}')" class="absolute bottom-2.5 right-2.5 bg-white/95 hover:bg-oliveBio hover:text-white text-oliveBio text-[11px] font-bold px-3 py-1 rounded-full shadow transition">
                Vue rapide
              </button>
            </div>
            <div class="p-3.5 sm:p-4 space-y-1">
              <p class="text-[10px] font-bold uppercase tracking-wider text-kasbahTerra">${CATEGORY_NAMES[item.cat] || 'Coffret'}</p>
              <h3 class="font-bold text-xs sm:text-sm text-oliveBio line-clamp-2 min-h-[2.4rem]">${item.name}</h3>
            </div>
          </div>
