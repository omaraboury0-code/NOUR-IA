<div class="special-offer-box">
  <div class="offer-header">
    <h3>💰 Offre Spéciale - Économisez Plus!</h3>
    <p>Choisissez votre forfait préféré</p>
  </div>

  <div class="offer-options">
    <!-- Option 1 : Offre Essentielle (Sélectionnée par défaut) -->
    <label class="offer-card selected">
      <input type="radio" name="forfait" value="1_support" checked>
      <div class="offer-content">
        <img src="votre-image-1-support.jpg" alt="1 support" class="offer-thumb">
        <div class="offer-details">
          <div class="offer-title">✨ Offre Essentielle — 1 support</div>
          <div class="offer-price">15 000 FCFA</div>
        </div>
      </div>
    </label>

    <!-- Option 2 : Offre Duo -->
    <label class="offer-card">
      <input type="radio" name="forfait" value="2_supports">
      <div class="offer-content">
        <img src="votre-image-2-supports.jpg" alt="2 supports" class="offer-thumb">
        <div class="offer-details">
          <div class="offer-title">🔥 Offre Duo — 2 supports <span class="badge-promo">-20%</span></div>
          <div class="offer-price">24 000 FCFA <span class="old-price">30 000 FCFA</span></div>
        </div>
      </div>
    </label>

    <!-- Option 3 : Offre Famille -->
    <label class="offer-card">
      <input type="radio" name="forfait" value="3_supports">
      <div class="offer-content">
        <img src="votre-image-3-supports.jpg" alt="3 supports" class="offer-thumb">
        <div class="offer-details">
          <div class="offer-title">👑 Offre Famille — 3 supports <span class="badge-promo">Meilleur choix</span></div>
          <div class="offer-price">33 000 FCFA <span class="old-price">45 000 FCFA</span></div>
        </div>
      </div>
    </label>
  </div>
</div>
