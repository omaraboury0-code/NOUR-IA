/* --- SECTION HERO --- */
.hero-section {
  position: relative;
  width: 100%;
  min-height: 90vh;
  display: flex;
  align-items: center;
  justify-content: center;
  /* HNA KATHET SMIT TASWIRA: */
  background-image: url('hero-bg.jpg'); 
  background-size: cover;
  background-position: center 35%;
  background-repeat: no-repeat;
  background-attachment: scroll;
  color: #ffffff;
  padding: 80px 20px;
  overflow: hidden;
  font-family: 'Poppins', 'Segoe UI', system-ui, sans-serif;
}

/* Tabqa ghamqa dafia (Overlay) bach l'ktaba tqra mzyan */
.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg, 
    rgba(22, 13, 8, 0.65) 0%, 
    rgba(22, 13, 8, 0.5) 60%, 
    rgba(15, 8, 5, 0.75) 100%
  );
  z-index: 1;
}

.hero-container {
  position: relative;
  z-index: 2;
  max-width: 880px;
  margin: 0 auto;
  text-align: center;
}

/* Badge sghir foq l'ktaba */
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background-color: rgba(235, 104, 139, 0.25);
  border: 1px solid rgba(235, 104, 139, 0.45);
  color: #ffdce5;
  padding: 8px 18px;
  border-radius: 50px;
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.5px;
  margin-bottom: 25px;
  backdrop-filter: blur(4px);
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
}

/* L'3onwan l'kbira */
.hero-title {
  font-size: clamp(2.2rem, 4.5vw, 3.8rem);
  font-weight: 800;
  line-height: 1.25;
  margin-bottom: 20px;
  color: #ffffff;
  text-shadow: 0 4px 12px rgba(0, 0, 0, 0.4);
}

.hero-title span {
  color: #ff94b1;
  background: linear-gradient(90deg, #ff94b1, #ffb5c8);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* L'wasf dyal site */
.hero-subtitle {
  font-size: clamp(1rem, 1.8vw, 1.25rem);
  line-height: 1.6;
  max-width: 680px;
  margin: 0 auto 35px auto;
  color: #f7e6ea;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
}

/* L'boutonat (CTA) */
.hero-cta-group {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 45px;
}

.btn {
  padding: 14px 32px;
  font-size: 1.05rem;
  font-weight: 600;
  border-radius: 50px;
  text-decoration: none;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background-color: #d15678;
  color: #ffffff;
  box-shadow: 0 6px 20px rgba(209, 86, 120, 0.35);
}

.btn-primary:hover {
  background-color: #b84362;
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(209, 86, 120, 0.5);
}

