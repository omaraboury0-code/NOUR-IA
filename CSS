.hero-section {
  position: relative;
  width: 100%;
  min-height: 80vh; /* wla 100vh ila bghitiha tkoun 3la tol l'écran */
  background-image: url('hero-bg.jpg'); /* badelha l 'images/hero-bg.jpg' ila htitiha f dossier images */
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #ffffff;
  overflow: hidden;
}

/* Tabqa ghamqa khfifa bach l'ktaba tban mzyan foq taswira */
.hero-overlay {
  position: absolute;
  inset: 0;
  background: rgba(20, 12, 8, 0.45);
  z-index: 1;
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 750px;
  padding: 24px;
}

.hero-content h1 {
  font-size: clamp(2rem, 4vw, 3.2rem);
  margin-bottom: 12px;
  font-weight: 700;
}

.hero-content p {
  font-size: 1.1rem;
  margin-bottom: 24px;
  opacity: 0.95;
}

.hero-btn {
  display: inline-block;
  padding: 12px 28px;
  background-color: #c96480;
  color: #ffffff;
  text-decoration: none;
  border-radius: 8px;
  font-weight: 600;
}
