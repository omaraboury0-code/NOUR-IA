.site-wallpaper {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: -2;
  pointer-events: none;
}

.site-wallpaper-overlay {
  position: fixed;
  inset: 0;
  background: rgba(20, 14, 10, 0.45);
  z-index: -1;
  pointer-events: none;
}
